{
  "name": "@rsbuild/plugin-assets-retry",
  "version": "2.0.2",
  "description": "An Rsbuild plugin to automatically resend requests when static assets fail to load.",
  "homepage": "https://github.com/rstackjs/rsbuild-plugin-assets-retry#readme",
  "bugs": {
    "url": "https://github.com/rstackjs/rsbuild-plugin-assets-retry/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rstackjs/rsbuild-plugin-assets-retry.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rs lib",
    "bump": "pnpx bumpp",
    "check": "rs check",
    "dev": "rs lib -w",
    "format": "rs fmt",
    "lint": "rs lint",
    "lint:write": "rs lint --fix && rs fmt",
    "prepare": "rs hooks",
    "test": "rs test"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.0",
    "@rsbuild/core": "^2.2.1",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rstackjs/test-utils": "^0.2.0",
    "@rstest/playwright": "^0.11.11",
    "@swc/core": "^1.16.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/serialize-javascript": "^5.0.4",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rsbuild-plugin-publint": "^1.0.0",
    "rstack": "^0.7.1",
    "serialize-javascript": "^7.1.1",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@rsbuild/core": "^1.0.0 || ^2.0.0"
  },
  "peerDependenciesMeta": {
    "@rsbuild/core": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.24.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
